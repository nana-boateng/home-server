# /opt/nebula-sync.env on dns (CT 100).  MODE 600 — plaintext admin passwords.
#
# nebula-sync is the Pi-hole v6 tool. Orbital Sync is v5-era, built around the
# old API and Teleporter workflow, with one repo archived in March 2025.
#
# PRIMARY is addressed as 10.0.0.31, NOT the VIP. Sync must always push FROM the
# real primary, never from whoever happens to be holding 10.0.0.33.
#
# IF THE SERVICE RESTARTS EVERY 30 SECONDS, THESE TWO ARE NOT SET. That is the
# documented behaviour for missing config, not a crash.

PRIMARY=http://10.0.0.31|<primary admin password>
REPLICAS=http://10.0.0.32|<replica admin password>
FULL_SYNC=true
RUN_GRAVITY=true
CRON=0 * * * *
