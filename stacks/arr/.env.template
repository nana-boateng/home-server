TZ=America/Toronto

# 3004 = sisyphus. The NFS share is mode drwx------ owned 3004:3004, so only
# this exact UID can read it.
PUID=3004
PGID=3004

# Node-local ZFS — /config, databases, runtime state. Never NFS.
APPDATA_DIR=/opt/appdata

# The sisyphus NFS mount. MUST be the identical string here and in grab, or
# hardlinks fail silently and imports double disk usage.
STORAGE_DIR=/mnt/sisyphus

# themis-500 HDD scratch, bind-mounted into the LXC. Per-client subfolders.
INCOMPLETE_DIR=/mnt/incomplete
