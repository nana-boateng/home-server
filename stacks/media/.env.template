TZ=

# 3004 = sisyphus. The NFS share is mode drwx------ and owned 3004:3004, so
# only this exact UID can read it. Do not change without re-checking the share.
PUID=3004
PGID=3004

# Node-local ZFS — /config, databases, runtime state. Never NFS.
APPDATA_DIR=/opt/appdata

# The sisyphus NFS mount. This path string must be IDENTICAL on the host, in
# this LXC, and in arr and grab, or hardlinks fail silently (D21).
STORAGE_DIR=/mnt/sisyphus

# Claim token from https://plex.tv/claim (valid 4 minutes)
PLEX_CLAIM=

# No RENDER_GID. The render node is passed into the LXC owned by group 3004 —
# the same UID/GID every service here runs as — because the container's own
# `render` group (992) is not one that abc belongs to, and the linuxserver init
# that would add it does not fire inside an idmapped LXC:
#   pct set 200 -dev0 /dev/dri/renderD128,gid=3004,mode=0660

# Posterizarr needs TMDB at minimum; Fanart.tv and TVDB improve coverage.
TMDB_API_KEY=
FANART_API_KEY=
TVDB_API_KEY=
